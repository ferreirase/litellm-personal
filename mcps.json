{
  "mcpServers": {
    "claude-context": {
      "command": "npx",
      "args": ["-y", "@zilliz/claude-context-mcp"],
      "disabled": false
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "/data/Estudos/AI/stdio2sse"
      ],
      "disabledTools": [
        "read_file",
        "list_dir",
        "create_text_file",
        "find_file",
        "search_for_pattern",
        "replace_regex",
        "execute_shell_command",
        "get_current_config",
        "initial_instructions",
        "prepare_for_new_conversation",
        "remove_project",
        "summarize_changes",
        "switch_modes",
        "think_about_collected_information",
        "think_about_task_adherence",
        "think_about_whether_you_are_done"
      ]
    },
    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander@latest"],
      "env": {
        "ALLOWED_DIRECTORIES": "/data",
        "BLOCKED_COMMANDS": "rm -rf /,dd,mkfs,sudo,su"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "backlog": {
      "command": "backlog",
      "args": ["mcp", "start"],
      "env": {
        "BACKLOG_PROJECT_PATH": "/data/Estudos/AI/stdio2sse"
      }
    }
  }
}
